# Rate Limiter API - Environment Configuration
# Copy this file to .env and adjust values as needed

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rate_limiter_db
MONGODB_COLLECTION=rate_limits

# Rate Limiter Configuration
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Security
# Number of trusted proxies in front of the application
# 0 = no proxy (default), 1 = one proxy, etc.
# When > 0, the application will trust X-Forwarded-For headers from that many proxies
TRUSTED_PROXY_COUNT=0

# Timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=30.0
MONGODB_TIMEOUT_MS=5000